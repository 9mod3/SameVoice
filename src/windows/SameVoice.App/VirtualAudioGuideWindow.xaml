<Window x:Class="SameVoice.App.VirtualAudioGuideWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="双路由设置向导"
        Width="820" Height="760"
        MinWidth="720" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#0C1220"
        Foreground="#E7EEF9">
    <Window.Resources>
        <Style x:Key="GuideButton" TargetType="Button">
            <Setter Property="Background" Value="#1B2942" />
            <Setter Property="Foreground" Value="#DCE8FA" />
            <Setter Property="BorderBrush" Value="#2B3B59" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="13,8" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#243654" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="GuidePrimary" TargetType="Button" BasedOn="{StaticResource GuideButton}">
            <Setter Property="Background" Value="#2C6BFF" />
            <Setter Property="BorderBrush" Value="#2C6BFF" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="GuideCard" TargetType="Border">
            <Setter Property="Background" Value="#121A2B" />
            <Setter Property="BorderBrush" Value="#24324B" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
    </Window.Resources>

    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="双路由设置向导" FontSize="25" FontWeight="SemiBold" />
            <TextBlock Text="没有虚拟声卡时，同声只能走单路由：本机静音可能连带 Android 输出静音。按下面三步启用双路由。"
                       FontSize="11.5" Foreground="#98A8C2" TextWrapping="Wrap" Margin="0,8,0,16" />
        </StackPanel>

        <Border x:Name="StatusCard" Grid.Row="1" Background="#241B10" BorderBrush="#6B5230"
                BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock x:Name="StatusTitle" Text="正在检测…" FontSize="14" FontWeight="SemiBold" Foreground="#FFD18A" />
                <TextBlock x:Name="StatusDetail" Text="" FontSize="11" Foreground="#C6B28D"
                           TextWrapping="Wrap" Margin="0,5,0,0" LineHeight="18" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Style="{StaticResource GuideCard}">
                    <StackPanel>
                        <TextBlock Text="1  安装虚拟声卡" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="推荐 Voicemeeter Banana：A1 接本机扬声器，B1 作为同声采集源。安装需要管理员权限，安装完成后建议重启。"
                                   FontSize="11" Foreground="#96A7BF" TextWrapping="Wrap" LineHeight="18" Margin="0,6,0,12" />
                        <WrapPanel>
                            <Button Style="{StaticResource GuidePrimary}" Content="下载 Voicemeeter Banana"
                                    Click="DownloadVoicemeeter_Click" Margin="0,0,10,8" />
                            <Button Style="{StaticResource GuideButton}" Content="下载 VB-CABLE"
                                    Click="DownloadCable_Click" Margin="0,0,10,8" />
                            <Button Style="{StaticResource GuideButton}" Content="打开 Windows 声音设置"
                                    Click="OpenSoundSettings_Click" Margin="0,0,0,8" />
                        </WrapPanel>
                        <TextBlock Text="同声不捆绑、不静默安装第三方驱动。请从官方页面下载并自行确认许可证。"
                                   FontSize="10" Foreground="#687993" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource GuideCard}">
                    <StackPanel>
                        <TextBlock Text="2  配置 A1 / B1" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock FontSize="11" Foreground="#A6B5CA" TextWrapping="Wrap" LineHeight="21" Margin="0,8,0,0">
                            <Run Text="1. 打开 Voicemeeter，把 " /><Run Text="A1" FontWeight="SemiBold" /><Run Text=" 设为你的扬声器或耳机。" />
                            <LineBreak />
                            <Run Text="2. 确认 " /><Run Text="B1" FontWeight="SemiBold" /><Run Text=" 是虚拟输出（Voicemeeter Out B1）。" />
                            <LineBreak />
                            <Run Text="3. Windows 默认播放设备设为 " /><Run Text="Voicemeeter Input" FontWeight="SemiBold" /><Run Text="。" />
                            <LineBreak />
                            <Run Text="4. 要把声音送到 Android 的应用，输出设备都选 Voicemeeter Input。" />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource GuideCard}">
                    <StackPanel>
                        <TextBlock Text="3  在同声里选择设备" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock FontSize="11" Foreground="#A6B5CA" TextWrapping="Wrap" LineHeight="21" Margin="0,8,0,0">
                            <Run Text="采集设备" FontWeight="SemiBold" /><Run Text="：Voicemeeter Out B1（或你的虚拟声卡输出）。" />
                            <LineBreak />
                            <Run Text="本机输出" FontWeight="SemiBold" /><Run Text="：A1 对应的物理扬声器/耳机。" />
                            <LineBreak />
                            <Run Text="配置正确后，本机静音只影响 A1，Android 输出继续。" />
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <TextBlock Text="安装或修改驱动后，回到这里点“重新检测”。"
                       FontSize="10" Foreground="#687993" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource GuideButton}" Content="重新检测"
                        Click="Recheck_Click" Margin="0,0,10,0" />
                <Button Style="{StaticResource GuidePrimary}" Content="关闭" Width="92"
                        Click="Close_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
