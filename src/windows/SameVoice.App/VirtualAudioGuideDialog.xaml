<Window x:Class="SameVoice.App.VirtualAudioGuideDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="虚拟声卡安装引导"
        Width="820" Height="700"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#0E1421"
        Foreground="#F4F7FF"
        FontFamily="Microsoft YaHei UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Border BorderBrush="#2B3650" BorderThickness="1" Background="#0E1421">
        <Grid Margin="24,18,24,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="28" Height="28" CornerRadius="9" Background="#1B3A3B" Margin="0,0,10,0">
                        <TextBlock Text="≋" FontSize="15" Foreground="#8DEBCF"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="虚拟声卡安装引导" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <Button Content="✕" Style="{StaticResource WindowButton}" HorizontalAlignment="Right"
                        Click="Close_Click" ToolTip="关闭" />
            </Grid>

            <!-- Detection status -->
            <Border x:Name="StatusBorder" Grid.Row="1" Margin="0,16,0,0" CornerRadius="12" Padding="14,12"
                    Background="#241A12" BorderBrush="#5C4326" BorderThickness="1">
                <StackPanel>
                    <TextBlock x:Name="StatusTitle" FontSize="12.5" FontWeight="SemiBold" Foreground="#F0C083"
                               Text="正在检测虚拟声卡…" />
                    <TextBlock x:Name="StatusDetail" FontSize="10.5" Foreground="#B9A78C" TextWrapping="Wrap"
                               LineHeight="18" Margin="0,5,0,0" Text="正在读取 Windows 播放设备列表。" />
                    <TextBlock x:Name="DetectedText" FontSize="9.5" Foreground="#8B7C69" TextWrapping="Wrap"
                               Margin="0,4,0,0" Text="" />
                    <Border Background="#16FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1"
                            CornerRadius="8" Padding="10,8" Margin="0,8,0,0">
                        <TextBlock x:Name="AdminHintText" FontSize="9.5" Foreground="#C8D4E4"
                                   TextWrapping="Wrap" LineHeight="16"
                                   Text="⚠ 建议以管理员身份运行同声：右键同声图标 → 以管理员身份运行。否则「打开下载页面」可能无法调起浏览器，安装虚拟声卡驱动时也需要管理员权限。" />
                    </Border>
                </StackPanel>
            </Border>

            <!-- Install options -->
            <StackPanel Grid.Row="2" Margin="0,16,0,0">
                <TextBlock Text="选择一种方案（安装完成后回到这里点「重新检测」）" FontSize="10.5"
                           Foreground="#8592A8" Margin="2,0,0,8" />
                <UniformGrid Columns="3">
                    <RadioButton x:Name="CableOption" Style="{StaticResource ModeCard}"
                                 Tag="VirtualCable" Margin="0,0,10,0" Checked="Option_Checked">
                        <StackPanel>
                            <TextBlock Text="VB-CABLE" FontSize="12.5" FontWeight="SemiBold" />
                            <TextBlock Text="最轻量：一对虚拟输入/输出，安装即用，免费。" FontSize="9.5"
                                       Foreground="#7D8AA0" TextWrapping="Wrap" Margin="0,5,0,0" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="VoicemeeterOption" Style="{StaticResource ModeCard}"
                                 Tag="Voicemeeter" Margin="0,0,10,0" Checked="Option_Checked">
                        <StackPanel>
                            <TextBlock Text="Voicemeeter" FontSize="12.5" FontWeight="SemiBold" />
                            <TextBlock Text="虚拟调音台：A1 接扬声器、B1 接虚拟输出，本机音量可独立调节。" FontSize="9.5"
                                       Foreground="#7D8AA0" TextWrapping="Wrap" Margin="0,5,0,0" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="ScreamOption" Style="{StaticResource ModeCard}"
                                 Tag="Scream" Checked="Option_Checked">
                        <StackPanel>
                            <TextBlock Text="Scream" FontSize="12.5" FontWeight="SemiBold" />
                            <TextBlock Text="虚拟声卡 + 局域网发送，手机也可以用同声直接接收。" FontSize="9.5"
                                       Foreground="#7D8AA0" TextWrapping="Wrap" Margin="0,5,0,0" />
                        </StackPanel>
                    </RadioButton>
                </UniformGrid>
            </StackPanel>

            <!-- Steps -->
            <Border Grid.Row="3" Margin="0,14,0,0" Background="#0C111D" BorderBrush="#202A3D"
                    BorderThickness="1" CornerRadius="12" Padding="16,14">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <TextBlock x:Name="StepsText" FontSize="11" Foreground="#C3CFE2" TextWrapping="Wrap"
                               LineHeight="20" Text="正在准备步骤…" />
                </ScrollViewer>
            </Border>

            <!-- Footer -->
            <Grid Grid.Row="4" Margin="0,16,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button x:Name="DownloadButton" Content="打开下载页面" Style="{StaticResource PrimaryButton}"
                            Height="38" Padding="18,0" Click="Download_Click" />
                    <Button Content="打开 Windows 声音设置" Style="{StaticResource SecondaryButton}"
                            Height="38" Padding="16,0" Margin="10,0,0,0" Click="OpenSoundSettings_Click" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="重新检测" Style="{StaticResource SecondaryButton}" Height="38"
                            Padding="16,0" Click="Rescan_Click" />
                    <Button x:Name="ApplyButton" Content="设为采集设备" Style="{StaticResource SecondaryButton}"
                            Height="38" Padding="16,0" Margin="10,0,0,0" IsEnabled="False" Click="Apply_Click" />
                    <Button Content="关闭" Style="{StaticResource SecondaryButton}" Height="38"
                            Padding="18,0" Margin="10,0,0,0" Click="Close_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
