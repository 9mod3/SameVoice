<Window x:Class="SameVoice.App.CloseChoiceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关闭同声"
        Width="460" Height="246"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#0E1421"
        Foreground="#F4F7FF"
        FontFamily="Microsoft YaHei UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Border BorderBrush="#2B3650" BorderThickness="1" Background="#0E1421" CornerRadius="0">
        <Grid Margin="24,20,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="28" Height="28" CornerRadius="9" Background="#1B3A3B" Margin="0,0,10,0">
                        <TextBlock Text="≋" FontSize="15" Foreground="#8DEBCF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="关闭同声" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <Button Content="✕" Style="{StaticResource WindowButton}" HorizontalAlignment="Right"
                        Click="Cancel_Click" ToolTip="取消" />
            </Grid>

            <TextBlock x:Name="MessageText" Grid.Row="1" FontSize="13" Foreground="#E7EEFA"
                       TextWrapping="Wrap" Margin="0,20,0,0" />
            <TextBlock x:Name="HintText" Grid.Row="2" FontSize="10.5" Foreground="#78859B"
                       TextWrapping="Wrap" LineHeight="18" Margin="0,8,0,0" />

            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="取消" Style="{StaticResource WindowButton}" Width="58" Height="32"
                        Margin="0,0,10,0" Click="Cancel_Click" />
                <Button Content="直接退出" Style="{StaticResource SecondaryButton}" Height="34"
                        Padding="16,0" Margin="0,0,10,0" Click="Exit_Click" />
                <Button x:Name="MinimizeButton" Content="最小化到系统托盘" Style="{StaticResource PrimaryButton}"
                        Height="34" Padding="18,0" Click="Minimize_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
