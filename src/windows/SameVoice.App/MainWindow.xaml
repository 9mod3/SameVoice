<Window x:Class="SameVoice.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="同声 SameVoice"
        Width="1160" Height="858" MinWidth="1020" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="#080B13" Foreground="#F4F7FF"
        FontFamily="Microsoft YaHei UI"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        StateChanged="Window_StateChanged"
        Closing="Window_Closing">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#080B13" Offset="0" />
                <GradientStop Color="#090D18" Offset="0.55" />
                <GradientStop Color="#070A11" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <Ellipse Width="720" Height="720" HorizontalAlignment="Right" VerticalAlignment="Top"
                 Margin="0,-330,-300,0" Fill="#334B95" Opacity="0.17" IsHitTestVisible="False">
            <Ellipse.Effect><BlurEffect Radius="170" /></Ellipse.Effect>
        </Ellipse>
        <Ellipse Width="620" Height="620" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                 Margin="-300,0,0,-300" Fill="#1F7A67" Opacity="0.14" IsHitTestVisible="False">
            <Ellipse.Effect><BlurEffect Radius="160" /></Ellipse.Effect>
        </Ellipse>

        <Border BorderBrush="#22293A" BorderThickness="1" Background="Transparent" />
        <Grid Margin="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="246" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="#0B1019" BorderBrush="#1B2232" BorderThickness="0,0,1,0">
                <Grid Margin="18,22,18,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="6,2,0,30">
                        <Border Width="46" Height="46" CornerRadius="14">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#1C3B40" Offset="0" />
                                    <GradientStop Color="#214A5D" Offset="0.55" />
                                    <GradientStop Color="#3D5D9C" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect Color="#5FF0C1" BlurRadius="22" ShadowDepth="0" Opacity="0.28" />
                            </Border.Effect>
                            <Grid>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border Width="3" Height="10" CornerRadius="1.5" Background="#F0F7FF" Margin="1,0" />
                                    <Border Width="3" Height="20" CornerRadius="1.5" Background="#F0F7FF" Margin="1,0" />
                                    <Border Width="3" Height="28" CornerRadius="1.5" Background="#F0F7FF" Margin="1,0" />
                                    <Border Width="3" Height="16" CornerRadius="1.5" Background="#F0F7FF" Margin="1,0" />
                                    <Border Width="3" Height="8" CornerRadius="1.5" Background="#F0F7FF" Margin="1,0" />
                                </StackPanel>
                                <Border Width="20" Height="3" CornerRadius="1.5" Background="#67E8C1"
                                        HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8" />
                            </Grid>
                        </Border>
                        <StackPanel Margin="12,1,0,0" VerticalAlignment="Center">
                            <TextBlock Text="同声" FontSize="20" FontWeight="Bold" Foreground="#F7FAFF" />
                            <TextBlock Text="SAMEVOICE" FontSize="8.5" FontWeight="SemiBold" Foreground="#6D7990" Margin="1,2,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="1">
                        <TextBlock Text="工作台" FontSize="10" Foreground="#4F5A70" Margin="18,0,0,8" />
                        <ToggleButton x:Name="NavHostButton" Style="{StaticResource NavButton}" IsChecked="True" Click="NavHost_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="◉" FontSize="15" Width="27" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                                <TextBlock Text="输出中心" FontSize="13.5" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton x:Name="NavShareButton" Style="{StaticResource NavButton}" Click="NavShare_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⇄" FontSize="17" Width="27" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                                <TextBlock Text="共享声音" FontSize="13.5" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton x:Name="NavSettingsButton" Style="{StaticResource NavButton}" Click="NavSettings_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚙" FontSize="16" Width="27" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                                <TextBlock Text="设置" FontSize="13.5" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                            </StackPanel>
                        </ToggleButton>
                    </StackPanel>

                    <StackPanel Grid.Row="3">
                        <Border Background="#0F1623" BorderBrush="#1D2738" BorderThickness="1" CornerRadius="16"
                                Padding="15,14" Margin="0,0,0,14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                                    <Ellipse Width="6" Height="6" Fill="{StaticResource Mint}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="本地直连" FontSize="11.5" FontWeight="SemiBold" Foreground="#DCE6F8" />
                                </StackPanel>
                                <TextBlock Text="声音只经过当前 Wi-Fi，不经过云端，不上传、不录音。"
                                           TextWrapping="Wrap" FontSize="10.5" Foreground="#68748A" LineHeight="17" />
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="EditionText" Text="SameVoice 1.4.0" FontSize="9.5" Foreground="#3F4A5F" Margin="4,0,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main area -->
            <Grid Grid.Column="1" Margin="30,0,26,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="44" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <TextBlock Text="SAME VOICE  /  LAN AUDIO MIXER" FontSize="8.5"
                               Foreground="#3D475A" VerticalAlignment="Center" Margin="2,4,0,0" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
                        <Button x:Name="MinimizeButton" Style="{StaticResource WindowButton}" Content="—" Click="Minimize_Click" ToolTip="最小化" />
                        <Button x:Name="MaximizeButton" Style="{StaticResource WindowButton}" Content="□" Click="Maximize_Click" ToolTip="最大化" />
                        <Button Style="{StaticResource CloseWindowButton}" Content="✕" Click="Close_Click" ToolTip="关闭到托盘" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="4,10,2,22">
                    <StackPanel>
                        <TextBlock x:Name="PageTitleText" Text="输出中心" Style="{StaticResource Display}" FontSize="27" />
                        <TextBlock x:Name="PageSubtitleText" Text="把同一网络里的多台设备，变成一台同步播放器。"
                                   FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,7,0,0" />
                    </StackPanel>
                    <Border Style="{StaticResource Pill}" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Background="#0F1724" BorderBrush="#202A3E" BorderThickness="1" Padding="13,7">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="{StaticResource Mint}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding HostAddressText, Mode=OneWay}" FontSize="10.5" Foreground="#A8B4C9" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Grid.Row="2">
                    <!-- Host page -->
                    <ScrollViewer x:Name="HostPage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,8,10">
                            <Border CornerRadius="24" Padding="28" BorderThickness="1" BorderBrush="#2A3550">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#151D32" Offset="0" />
                                        <GradientStop Color="#101725" Offset="0.6" />
                                        <GradientStop Color="#0E1A1B" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="220" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,17">
                                            <Border Style="{StaticResource Pill}" Background="#20342F" Padding="10,5">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Fill="{Binding HostStatusBrush, Mode=OneWay}" Width="6" Height="6"
                                                             VerticalAlignment="Center" Margin="0,0,7,0" />
                                                    <TextBlock Text="{Binding HostBadge, Mode=OneWay}" FontSize="10.5" FontWeight="SemiBold"
                                                               Foreground="#B8EBDD" />
                                                </StackPanel>
                                            </Border>
                                            <TextBlock Text="输出中心" FontSize="10" Foreground="#66738C"
                                                       VerticalAlignment="Center" Margin="12,0,0,0" />
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource Display}" FontSize="30" LineHeight="41">
                                            让所有声音，<LineBreak />在这里汇合。
                                        </TextBlock>
                                        <TextBlock Text="{Binding HostStatusDetail, Mode=OneWay}" TextWrapping="Wrap"
                                                   FontSize="12.5" Foreground="#9BA8BE" LineHeight="22" MaxWidth="520"
                                                   Margin="0,12,0,20" />
                                        <StackPanel Orientation="Horizontal">
                                            <Button x:Name="HostToggleButton" Style="{StaticResource PrimaryButton}"
                                                    Content="{Binding HostButtonText, Mode=OneWay}" Click="HostToggle_Click" MinWidth="148" />
                                            <Button Style="{StaticResource SecondaryButton}" Content="复制本机地址"
                                                    Margin="12,0,0,0" Click="CopyAddress_Click" />
                                        </StackPanel>
                                        <TextBlock x:Name="HostErrorText" Text="" Foreground="{StaticResource Danger}"
                                                   FontSize="11.5" TextWrapping="Wrap" Margin="0,12,0,0" />
                                        <TextBlock Text="窗口关闭后会驻留系统托盘继续播放，不抢占、也不静音其他应用。"
                                                   Foreground="#5F6C82" FontSize="10.5" TextWrapping="Wrap" Margin="0,15,0,0" />
                                    </StackPanel>
                                    <Grid Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                        <Ellipse Width="195" Height="195" Stroke="#24334B" StrokeThickness="1" Opacity="0.8" />
                                        <Ellipse Width="150" Height="150" Stroke="#2C4258" StrokeThickness="1" Opacity="0.7" />
                                        <Ellipse Width="102" Height="102">
                                            <Ellipse.Fill>
                                                <RadialGradientBrush>
                                                    <GradientStop Color="#2E6A62" Offset="0" />
                                                    <GradientStop Color="#183331" Offset="0.7" />
                                                    <GradientStop Color="#0F1B21" Offset="1" />
                                                </RadialGradientBrush>
                                            </Ellipse.Fill>
                                        </Ellipse>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Border Width="4" Height="18" CornerRadius="2" Background="#7DF3CD" Margin="2,0" />
                                            <Border Width="4" Height="36" CornerRadius="2" Background="#7DF3CD" Margin="2,0" />
                                            <Border Width="4" Height="54" CornerRadius="2" Background="#A8F6E2" Margin="2,0" />
                                            <Border Width="4" Height="30" CornerRadius="2" Background="#7DF3CD" Margin="2,0" />
                                            <Border Width="4" Height="16" CornerRadius="2" Background="#7DF3CD" Margin="2,0" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding HostSourceText, Mode=OneWay}" FontSize="10" Foreground="#7F9A9B"
                                                   HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,12" />
                                    </Grid>
                                </Grid>
                            </Border>

                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="10*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="11*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="20">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="播放策略" FontSize="14" FontWeight="SemiBold" />
                                            <Border Style="{StaticResource Pill}" HorizontalAlignment="Right" Background="#15231F">
                                                <TextBlock Text="{Binding HostModeText, Mode=OneWay}" Style="{StaticResource PillText}" Foreground="#8DEBCF" />
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="多路音源使用同一输出时钟对齐；模式可随时切换。"
                                                   Style="{StaticResource SecondaryText}" Margin="0,6,0,12" />
                                        <RadioButton x:Name="BalancedModeRadio" GroupName="PlaybackMode"
                                                     Style="{StaticResource ModeCard}" Checked="Mode_Checked">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="同步优先" FontSize="13" FontWeight="SemiBold" />
                                                    <Border Background="#213B33" CornerRadius="6" Padding="6,2" Margin="8,0,0,0">
                                                        <TextBlock Text="推荐" FontSize="9" Foreground="#8DEBCF" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="约 240 ms 缓冲，多台设备严格对齐" FontSize="10.5"
                                                           Foreground="#73809A" Margin="0,6,0,0" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton x:Name="LowModeRadio" GroupName="PlaybackMode"
                                                     Style="{StaticResource ModeCard}" Checked="Mode_Checked" Margin="0,8,0,0">
                                            <StackPanel>
                                                <TextBlock Text="最低延迟" FontSize="13" FontWeight="SemiBold" />
                                                <TextBlock Text="约 120 ms 缓冲，优先速度，适合稳定 Wi-Fi" FontSize="10.5"
                                                           Foreground="#73809A" Margin="0,6,0,0" />
                                            </StackPanel>
                                        </RadioButton>
                                        <TextBlock Text="切换策略会重建抖动缓冲，约 0.2 秒静音属于正常现象。"
                                                   FontSize="9.5" Foreground="#4F5B70" TextWrapping="Wrap" Margin="2,9,0,0" />
                                        <Border Background="#0C111D" BorderBrush="#202C40" BorderThickness="1"
                                                CornerRadius="10" Padding="12,10" Margin="0,10,0,0">
                                            <StackPanel>
                                                <Grid>
                                                    <TextBlock Text="手动缓冲延迟" FontSize="11" Foreground="#A7B3C6" />
                                                    <TextBlock x:Name="BufferMsText" Text="240 ms" FontSize="11"
                                                               Foreground="#8DEBCF" HorizontalAlignment="Right" />
                                                </Grid>
                                                <Slider x:Name="BufferSlider" Style="{StaticResource VolumeSlider}"
                                                        Minimum="40" Maximum="1000" TickFrequency="10"
                                                        IsSnapToTickEnabled="True" Margin="0,4,0,0"
                                                        ValueChanged="Buffer_Changed" />
                                                <TextBlock Text="40–1000 ms。越低延迟越小，但 Wi-Fi 抖动时更容易断音。"
                                                           FontSize="9" Foreground="#566278" TextWrapping="Wrap" Margin="0,5,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="运行状态" FontSize="14" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding SourceCountText, Mode=OneWay}" HorizontalAlignment="Right"
                                                       FontSize="10.5" Foreground="#6F7C92" />
                                        </Grid>
                                        <Grid Margin="0,14,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="本机地址" FontSize="11" Foreground="#77839A" Margin="0,0,20,10" />
                                            <TextBlock Grid.Column="1" Text="{Binding HostAddressText, Mode=OneWay}" FontSize="11"
                                                       Foreground="#D7E0F0" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right" Margin="0,0,0,10" />
                                            <TextBlock Grid.Row="1" Text="监听端口" FontSize="11" Foreground="#77839A" Margin="0,0,20,10" />
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding HostPortsText, Mode=OneWay}" FontSize="11"
                                                       Foreground="#D7E0F0" HorizontalAlignment="Right" Margin="0,0,0,10" />
                                            <TextBlock Grid.Row="2" Text="当前音源" FontSize="11" Foreground="#77839A" Margin="0,0,20,11" />
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding HostSourceText, Mode=OneWay}" FontSize="11"
                                                       Foreground="#D7E0F0" HorizontalAlignment="Right" Margin="0,0,0,11" />
                                            <TextBlock Grid.Row="3" Text="主音量" FontSize="11" Foreground="#77839A" VerticalAlignment="Center" />
                                            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Style="{StaticResource IconButton}" Content="−" Width="27" Height="27" Click="VolumeDown_Click" />
                                                <TextBlock Text="{Binding MasterVolumeText, Mode=OneWay}" FontSize="11.5" Foreground="#E8EFFB"
                                                           Width="48" TextAlignment="Center" VerticalAlignment="Center" />
                                                <Button Style="{StaticResource IconButton}" Content="+" Width="27" Height="27" Click="VolumeUp_Click" />
                                            </StackPanel>
                                        </Grid>
                                        <Border Style="{StaticResource SubtleDivider}" Margin="0,13,0,10" />
                                        <TextBlock Text="{Binding HostStatusDetail, Mode=OneWay}" TextWrapping="Wrap" FontSize="10.5"
                                                   Foreground="#6E7A90" LineHeight="17" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Style="{StaticResource Card}" Padding="20" Margin="0,16,0,0">
                                <StackPanel>
                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="正在混音" FontSize="14" FontWeight="SemiBold" />
                                            <Border Style="{StaticResource Pill}" Background="#19232F" Margin="9,0,0,0" Padding="8,3">
                                                <TextBlock Text="{Binding SourceCountText, Mode=OneWay}" Style="{StaticResource PillText}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="每路独立音量 · 自动软限幅" HorizontalAlignment="Right"
                                                   FontSize="10" Foreground="#556177" VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock Text="还没有音源接入。打开其他设备上的同声，进入「共享声音」并选择这台电脑。"
                                               Style="{StaticResource EmptyText}"
                                               Visibility="{Binding HasSources, Converter={StaticResource InverseBoolToVis}}" />
                                    <ItemsControl ItemsSource="{Binding Sources}" Margin="0,13,0,0"
                                                  Visibility="{Binding HasSources, Converter={StaticResource BoolToVis}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource SourceCard}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="44" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="148" />
                                                            <ColumnDefinition Width="44" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="36" Height="36" CornerRadius="11" Background="#17242B"
                                                                VerticalAlignment="Center" HorizontalAlignment="Left">
                                                            <TextBlock Text="{Binding Initial, Mode=OneWay}" Foreground="#8DEBCF" FontSize="14"
                                                                       FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name, Mode=OneWay}" FontSize="12.5" FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding DetailText, Mode=OneWay}" FontSize="10" Foreground="#66738A"
                                                                       Margin="0,4,0,0" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="8,0,12,0">
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                                <Ellipse Fill="{Binding StatusBrush, Mode=OneWay}" Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                                <TextBlock Text="{Binding StatusText, Mode=OneWay}" FontSize="10.5" Foreground="#AAB7CB" />
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding BufferText, Mode=OneWay}" FontSize="9.5" Foreground="#576379"
                                                                       HorizontalAlignment="Right" Margin="0,4,0,0" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"
                                                                    Margin="0,0,8,0" ToolTip="调节该输入端在混音中的音量">
                                                            <TextBlock Text="音量" FontSize="9.5" Foreground="#657288" VerticalAlignment="Center" Margin="0,0,7,0" />
                                                            <Slider Style="{StaticResource VolumeSlider}" Width="86" Minimum="0" Maximum="100"
                                                                    Value="{Binding VolumePercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                    ValueChanged="SourceVolume_Changed" />
                                                            <TextBlock Text="{Binding VolumePercent, StringFormat={}{0:0}%}" FontSize="9.5"
                                                                       Foreground="#AAB7CB" Width="34" TextAlignment="Right" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right"
                                                                    VerticalAlignment="Center" Opacity="{Binding ActivityOpacity, Mode=OneWay}">
                                                            <Border Width="3" Height="10" CornerRadius="2" Background="#63DDBD" Margin="1,0" />
                                                            <Border Width="3" Height="20" CornerRadius="2" Background="#7DF3CD" Margin="1,0" />
                                                            <Border Width="3" Height="27" CornerRadius="2" Background="#63DDBD" Margin="1,0" />
                                                            <Border Width="3" Height="14" CornerRadius="2" Background="#7DF3CD" Margin="1,0" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Share page -->
                    <ScrollViewer x:Name="SharePage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Visibility="Collapsed">
                        <StackPanel Margin="0,0,8,10">
                            <Border CornerRadius="24" Padding="28" BorderThickness="1" BorderBrush="#2A3550">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#151C31" Offset="0" />
                                        <GradientStop Color="#101625" Offset="0.6" />
                                        <GradientStop Color="#0D1A20" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="280" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                            <Border Style="{StaticResource Pill}" Background="#1D2A44" Padding="10,5">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Fill="{Binding ShareStatusBrush, Mode=OneWay}" Width="6" Height="6"
                                                             VerticalAlignment="Center" Margin="0,0,7,0" />
                                                    <TextBlock Text="{Binding ShareBadge, Mode=OneWay}" FontSize="10.5" FontWeight="SemiBold"
                                                               Foreground="#C6D6F2" />
                                                </StackPanel>
                                            </Border>
                                            <TextBlock Text="音源设备" FontSize="10" Foreground="#66738C"
                                                       VerticalAlignment="Center" Margin="12,0,0,0" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding ShareStatusTitle, Mode=OneWay}" Style="{StaticResource Display}" FontSize="29" />
                                        <TextBlock Text="{Binding ShareStatusDetail, Mode=OneWay}" TextWrapping="Wrap"
                                                   FontSize="12.5" Foreground="#9BA8BE" LineHeight="22" MaxWidth="500" Margin="0,12,0,20" />
                                        <StackPanel Orientation="Horizontal">
                                            <Button x:Name="SharePrimaryButton" Style="{StaticResource PrimaryButton}"
                                                    Content="{Binding ShareButtonText, Mode=OneWay}" Click="SharePrimary_Click" MinWidth="148" />
                                            <Button Style="{StaticResource SecondaryButton}" Content="刷新设备列表"
                                                    Margin="12,0,0,0" Click="ScanHosts_Click" />
                                            <Button x:Name="LocalMuteButton" Style="{StaticResource SecondaryButton}"
                                                    Content="本机静音" Margin="12,0,0,0" Visibility="Collapsed"
                                                    Click="LocalMute_Click" />
                                        </StackPanel>
                                        <TextBlock Text="Windows 会捕获默认扬声器上所有应用的声音；不会影响这些应用继续正常播放。"
                                                   Foreground="#5F6C82" FontSize="10.5" TextWrapping="Wrap" Margin="0,12,0,0" />
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <TextBlock Text="传输音质" FontSize="10.5" Foreground="#8592A8"
                                                       VerticalAlignment="Center" Margin="0,0,10,0" />
                                            <ComboBox x:Name="QualityCombo" Style="{StaticResource DarkComboBox}"
                                                      Width="220" SelectionChanged="Quality_Changed" />
                                        </StackPanel>
                                        <TextBlock Text="高音质为 48 kHz/24-bit；输出端不支持时自动回退标准 16-bit。"
                                                   Foreground="#5F6C82" FontSize="9.5" TextWrapping="Wrap" Margin="0,6,0,0" />

                                        <Border x:Name="DualRoutePanel" Style="{StaticResource Card}" Padding="16"
                                                Margin="0,14,0,0" Visibility="Collapsed">
                                            <StackPanel>
                                                <TextBlock Text="双路由：本机与输出端完全独立" FontSize="12.5"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="先把 Windows 应用路由到 Voicemeeter Input：A1 接本机扬声器，B1 接 Scream/VB-CABLE；然后在这里选择 B1 作为采集设备。"
                                                           TextWrapping="Wrap" FontSize="10.5" Foreground="#718097"
                                                           LineHeight="18" Margin="0,6,0,10" />
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="采集设备" FontSize="10.5" Foreground="#8592A8"
                                                               VerticalAlignment="Center" Margin="0,0,10,0" />
                                                    <ComboBox x:Name="CaptureDeviceCombo" Grid.Column="1"
                                                              Style="{StaticResource DarkComboBox}"
                                                              SelectionChanged="CaptureDevice_Changed" />
                                                    <Button Grid.Column="2" Style="{StaticResource SecondaryButton}"
                                                            Content="刷新" Height="30" Padding="12,0" Margin="8,0,0,0"
                                                            Click="RefreshCaptureDevices_Click" />
                                                </Grid>
                                                <Grid Margin="0,10,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="本机输出" FontSize="10.5" Foreground="#8592A8"
                                                               VerticalAlignment="Center" Margin="0,0,10,0" />
                                                    <ComboBox x:Name="LocalOutputCombo" Grid.Column="1"
                                                              Style="{StaticResource DarkComboBox}"
                                                              SelectionChanged="LocalOutput_Changed" />
                                                </Grid>
                                                <Grid Margin="0,10,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="42" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="本机音量" FontSize="10.5" Foreground="#8592A8"
                                                               VerticalAlignment="Center" Margin="0,0,10,0" />
                                                    <Slider x:Name="DualLocalVolumeSlider" Grid.Column="1"
                                                            Style="{StaticResource VolumeSlider}" Minimum="0" Maximum="100"
                                                            VerticalAlignment="Center" ValueChanged="DualLocalVolume_Changed" />
                                                    <TextBlock x:Name="DualLocalVolumeText" Grid.Column="2" Text="—"
                                                               FontSize="10.5" Foreground="#D3DDEC" TextAlignment="Right"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                                <Grid Margin="0,8,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="52" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="发送增益" FontSize="10.5" Foreground="#8592A8"
                                                               VerticalAlignment="Center" Margin="0,0,10,0" />
                                                    <Slider x:Name="DualRemoteGainSlider" Grid.Column="1"
                                                            Style="{StaticResource VolumeSlider}" Minimum="0" Maximum="600"
                                                            VerticalAlignment="Center" ValueChanged="DualRemoteGain_Changed" />
                                                    <TextBlock x:Name="DualRemoteGainText" Grid.Column="2" Text="—"
                                                               FontSize="10.5" Foreground="#D3DDEC" TextAlignment="Right"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                                <TextBlock Text="本机音量控制物理扬声器，发送增益只影响送往输出端的流；两者互不影响。双路由默认不做固定放大，发送增益可在 0–600% 调整。"
                                                           TextWrapping="Wrap" FontSize="9.5" Foreground="#566278"
                                                           LineHeight="16" Margin="0,8,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <Border Grid.Column="1" Background="#0C1420" BorderBrush="#202C40" BorderThickness="1"
                                            CornerRadius="18" Padding="18" VerticalAlignment="Center" Margin="16,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="连接详情" FontSize="10.5" Foreground="#718096" Margin="0,0,0,12" />
                                            <TextBlock Text="{Binding ShareHostName, Mode=OneWay}" FontSize="14" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <Border Style="{StaticResource SubtleDivider}" />
                                            <Grid Margin="0,0,0,9">
                                                <TextBlock Text="网络往返" FontSize="10" Foreground="#657288" />
                                                <TextBlock Text="{Binding ShareNetworkText, Mode=OneWay}" FontSize="10.5" Foreground="#C3D0E2"
                                                           HorizontalAlignment="Right" />
                                            </Grid>
                                            <Grid>
                                                <TextBlock Text="已发送" FontSize="10" Foreground="#657288" />
                                                <TextBlock Text="{Binding SharePacketText, Mode=OneWay}" FontSize="10.5" Foreground="#C3D0E2"
                                                           HorizontalAlignment="Right" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="5*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="4*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="20">
                                    <StackPanel>
                                        <Grid>
                                            <StackPanel>
                                                <TextBlock Text="附近的输出端" FontSize="14" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding HostCountText, Mode=OneWay}" Style="{StaticResource SecondaryText}" Margin="0,5,0,0" />
                                            </StackPanel>
                                            <Button Style="{StaticResource SecondaryButton}" Content="扫描"
                                                    Height="34" Padding="16,0" HorizontalAlignment="Right" Click="ScanHosts_Click" />
                                        </Grid>
                                        <TextBlock Text="正在扫描局域网…" Style="{StaticResource EmptyText}"
                                                   Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock Text="还没有发现输出端。请确认对方已开启「输出中心」，或使用右侧手动连接。"
                                                   Style="{StaticResource EmptyText}" TextWrapping="Wrap" MaxWidth="350"
                                                   Visibility="{Binding HasHosts, Converter={StaticResource InverseBoolToVis}}" />
                                        <ItemsControl ItemsSource="{Binding Hosts}" Margin="0,13,0,0"
                                                      Visibility="{Binding HasHosts, Converter={StaticResource BoolToVis}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource HostCard}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="40" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border Width="34" Height="34" CornerRadius="10" Background="#1B2740" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Initial, Mode=OneWay}" Foreground="#AAB7FF" FontSize="13"
                                                                           FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Border>
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,12,0">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding Name, Mode=OneWay}" FontSize="12.5" FontWeight="SemiBold"
                                                                               TextTrimming="CharacterEllipsis" MaxWidth="180" />
                                                                    <Border Background="#1D2A44" CornerRadius="6" Padding="6,2" Margin="8,0,0,0">
                                                                        <TextBlock Text="{Binding Mode, Mode=OneWay}" FontSize="9" Foreground="#AABDF5" />
                                                                    </Border>
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding DetailsLine, Mode=OneWay}" FontSize="9.5"
                                                                           Foreground="#647189" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                            <Button Grid.Column="2" Style="{StaticResource SecondaryButton}"
                                                                    Content="连接" Height="34" Padding="16,0"
                                                                    Tag="{Binding}" Click="ConnectHost_Click" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <StackPanel Grid.Column="2">
                                    <Border Style="{StaticResource Card}" Padding="20">
                                        <StackPanel>
                                            <TextBlock Text="手动连接" FontSize="14" FontWeight="SemiBold" />
                                            <TextBlock Text="输入输出端在「运行状态」中显示的 IP 地址。"
                                                       Style="{StaticResource SecondaryText}" Margin="0,6,0,11" />
                                            <TextBox x:Name="ManualIpBox" Style="{StaticResource TextBoxStyle}" Text="192.168.1.100" />
                                            <Button Style="{StaticResource SecondaryButton}" Content="连接这个地址"
                                                    Margin="0,10,0,0" Click="ConnectManualIp_Click" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Card}" Padding="20" Margin="0,16,0,0">
                                        <StackPanel>
                                            <TextBlock Text="共享须知" FontSize="11.5" FontWeight="SemiBold" Foreground="#D8E2F3" />
                                            <TextBlock Text="一个输出端最多接入 8 台音源；每路约占用 1.54 Mbps 上行带宽。请关闭 Wi-Fi 的 AP 隔离，确保设备处于同一子网。"
                                                       TextWrapping="Wrap" FontSize="10.5" Foreground="#6D7A90" LineHeight="18" Margin="0,9,0,0" />
                                            <TextBlock Text="Android 端需在系统弹窗中授权「录制或投射屏幕」，选择「共享内部音频」。受版权保护的视频可能无法被捕获。"
                                                       TextWrapping="Wrap" FontSize="10.5" Foreground="#6D7A90" LineHeight="18" Margin="0,9,0,0" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Settings page -->
                    <ScrollViewer x:Name="SettingsPage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Visibility="Collapsed">
                        <StackPanel Margin="0,0,8,10" MaxWidth="820" HorizontalAlignment="Left">
                            <Border Style="{StaticResource Card}" Padding="24">
                                <StackPanel>
                                    <TextBlock Text="这台设备" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Text="名称会显示在对方的设备列表里。修改后对下一次启动输出或共享生效。"
                                               Style="{StaticResource SecondaryText}" Margin="0,6,0,14" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="DeviceNameBox" Style="{StaticResource TextBoxStyle}" />
                                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="保存名称"
                                                Margin="10,0,0,0" Click="SaveDeviceName_Click" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Padding="24" Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Text="背景播放与混音" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Text="SameVoice 使用系统的共享音频模式，不申请独占音频设备，也不会自动压低其他应用。输出端最小化或关闭窗口后驻留托盘，音乐继续播放。"
                                               TextWrapping="Wrap" FontSize="11" Foreground="#8592A8" LineHeight="20" Margin="0,8,0,0" />
                                    <TextBlock Text="Windows 11 默认可能把新托盘图标放进任务栏的 ^ 隐藏区。右键托盘图标可以退出；也可以把图标拖到任务栏固定。"
                                               TextWrapping="Wrap" FontSize="10.5" Foreground="#6F7C92" LineHeight="18" Margin="0,7,0,0" />
                                    <Border Style="{StaticResource SubtleDivider}" />
                                    <Grid>
                                        <TextBlock Text="系统音频采集" FontSize="11" Foreground="#748098" />
                                        <TextBlock Text="WASAPI loopback（默认播放设备）" FontSize="11" Foreground="#D3DDEC" HorizontalAlignment="Right" />
                                    </Grid>
                                    <Grid Margin="0,9,0,0">
                                        <TextBlock Text="音频格式" FontSize="11" Foreground="#748098" />
                                        <TextBlock Text="48 kHz · 立体声 · PCM 16-bit" FontSize="11" Foreground="#D3DDEC" HorizontalAlignment="Right" />
                                    </Grid>
                                    <Grid Margin="0,9,0,0">
                                        <TextBlock Text="传输" FontSize="11" Foreground="#748098" />
                                        <TextBlock Text="局域网 UDP · 5 ms 分片 · 随机 Token" FontSize="11" Foreground="#D3DDEC" HorizontalAlignment="Right" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Padding="24" Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Text="网络与防火墙" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Text="如果其他设备扫描不到这台电脑，请允许同声通过 Windows 专用网络防火墙，并确认路由器没有开启 AP 隔离。"
                                               TextWrapping="Wrap" FontSize="11" Foreground="#8592A8" LineHeight="20" Margin="0,8,0,14" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource SecondaryButton}" Content="打开防火墙设置" Click="OpenFirewallSettings_Click" />
                                        <Button Style="{StaticResource SecondaryButton}" Content="打开网络设置"
                                                Margin="10,0,0,0" Click="OpenNetworkSettings_Click" />
                                    </StackPanel>
                                    <TextBlock Text="需要放行的端口：TCP 47820–47829（控制）、UDP 47821（发现）、UDP 47822（音频）。"
                                               TextWrapping="Wrap" FontSize="10" Foreground="#566278" Margin="0,12,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Padding="24" Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Text="已知限制" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Text="• 只能在同一个 IPv4 局域网中使用，不支持跨网段、VPN 或开启 AP 隔离的访客网络。"
                                               TextWrapping="Wrap" FontSize="10.5" Foreground="#738097" LineHeight="19" Margin="0,9,0,0" />
                                    <TextBlock Text="• 输出端本身不采集自己的系统声音（否则会形成回环）。请把输出端只当作扬声器，用其他设备提供声音。"
                                               TextWrapping="Wrap" FontSize="10.5" Foreground="#738097" LineHeight="19" Margin="0,6,0,0" />
                                    <TextBlock Text="• 音源与输出端需要完成时钟校准。设备刚接入时约 0.3 秒内开始出声。"
                                               TextWrapping="Wrap" FontSize="10.5" Foreground="#738097" LineHeight="19" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid Grid.Row="3" Margin="4,9,4,14">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="5" Height="5" Fill="#4A566C" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding LastMessage, Mode=OneWay}" FontSize="9.5" Foreground="#5C687D" TextTrimming="CharacterEllipsis"
                                   MaxWidth="700" />
                    </StackPanel>
                    <TextBlock Text="局域网 · 1.54 Mbps / 路 · PCM" HorizontalAlignment="Right"
                               FontSize="9" Foreground="#3E495C" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
